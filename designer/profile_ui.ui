    <string notr="true">QPushButton#changePasswordButton {
   background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, 
                                      stop:0 #1B2671, 
                                      stop:0.5 #34195E, 
                                      stop:1 #1B2631);
    border: 2px solid #1B2631;
    color: white;
	border-radius: 20px;
}

QPushButton#changePasswordButton:hover {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, 
                                      stop:0 #4CA7AF, 
                                      stop:0.5 #2C3E90, 
                                      stop:1 #4CA4AF);
}

QPushButton#changePasswordButton:pressed {
	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, 
                                      stop:0 #2C3E50, 
                                      stop:0.5 #4CA1AF, 
                                      stop:1 #2C3E50);
    border: 2px solid #2C3E50;
    color: white;
    padding: 5px;
    border-radius: 20px;
    font-size: 16px;
}
</string>
