   <property name="styleSheet">
    <string notr="true">QPushButton#changeButton {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, 
                                stop:0 #006400, 
                                stop:0.5 #008000, 
                                stop:1 #006400); /* Gradient arka plan */
    border: 2px solid #006400;   /* Kenarlık rengi */
    border-radius: 10px;         /* Kenarların köşelerini yuvarlama */
    color: white;                /* Metin rengi */
    padding: 5px;                /* Kenarlık ile metin arasındaki boşluk */
    font-size: 14px;             /* Yazı tipi boyutu */
    font-weight: bold;           /* Yazı tipi kalınlığı */
}

QPushButton#changeButton:hover {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, 
                                stop:0 #008000, 
                                stop:0.5 #00a000, 
                                stop:1 #008000); /* Gradient arka plan */
    border: 2px solid #008000;   /* Kenarlık rengi */
}

QPushButton#changeButton:pressed {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, 
                                stop:0 #004d00, 
                                stop:0.5 #006400, 
                                stop:1 #004d00); /* Gradient arka plan */
    border: 2px solid #004d00;   /* Kenarlık rengi */
    padding: 5px;                /* Kenarlık ile metin arasındaki boşluk */
    border-radius: 10px;         /* Kenarların köşelerini yuvarlama */
    color: white;                /* Metin rengi */
    font-size: 14px;             /* Yazı tipi boyutu */
    font-weight: bold;           /* Yazı tipi kalınlığı */
}
</string>
