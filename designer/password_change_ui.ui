   <property name="styleSheet">
    <string notr="true">QLabel#background {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, 
                                stop:0 #2c3e50, 
                                stop:0.5 #34495e, 
                                stop:1 #2c3e50); /* Gradient arka plan */
    border: 2px solid #34495e;     /* Kenarlık rengi */
    border-radius: 0px;          /* Kenarların köşelerini yuvarlama */
    padding: 5px;                 /* Kenarlık ile metin arasındaki boşluk */
    color: white;                 /* Metin rengi */
    font: bold 14px;              /* Kalın ve 14 piksel boyutunda yazı tipi */
    text-align: center;           /* Metni ortalama */
}
</string>
