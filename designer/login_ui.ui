    <property name="styleSheet">
     <string notr="true">QPushButton#kaydolButon{
	border: 2px solid white;
	border-radius:25px;
	color: white;
}

QPushButton#kaydolButon:hover{
	background-color: qlineargradient(
        spread:pad, x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(252, 243, 202, 255),
		stop:1 rgba(50, 190, 255, 255)
    ); /* Gradient arka plan rengi */
    border: 2px solid black; /* Hover border rengi */
	color: white;
}

QPushButton#kaydolButon:pressed{
	background-color: qlineargradient(
        spread:pad, x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(220, 220, 220, 255),
        stop:1 rgba(50, 120, 255, 255)
    ); /* Gradient arka plan rengi */
    border: 2px solid black;
	color: white;
}
</string>
