    <property name="styleSheet">
     <string notr="true">QPushButton#girisYapButon {
    border: 2px solid white;
    border-radius: 25px;
    color: white; 
}

QPushButton#girisYapButon:hover {
    background-color: qlineargradient(
        spread:pad, x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(222, 243, 202, 255),
        stop:1 rgba(76, 175, 80, 255)
    ); /* Gradient arka plan rengi */
    border: 2px solid black;
    color: white;
}

QPushButton#girisYapButon:pressed {
    background-color: qlineargradient(
        spread:pad, x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(252, 243, 202, 255),
        stop:1 rgba(104, 175, 13, 255)
    ); /* Gradient arka plan rengi */
    border: 2px solid black;
    color: white;
}
</string>
