# Copy this file to ".env" and adjust. Every setting is optional.

# --- Stockfish -----------------------------------------------------------
# Leave empty to auto-detect (Stockfish/ folder in the project, or PATH).
STOCKFISH_PATH=

# --- AI position explanations ---------------------------------------------
# Any OpenAI-compatible chat API works. Each user brings their own backend;
# no key is shipped with the app. If nothing is reachable, the app falls back
# to an engine-only explanation.
# Model names change over time - check your provider's model list.

# Option A (default): Ollama, free & local, no key needed.
#   1) install https://ollama.com   2) run:  ollama pull llama3.2
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=llama3.2
AI_API_KEY=

# Option B: Google Gemini (free tier key from https://aistudio.google.com/apikey)
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_MODEL=gemini-2.5-flash
# AI_API_KEY=your-key

# Option C: Groq (free tier key from https://console.groq.com/keys)
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-120b
# AI_API_KEY=your-key

# Option D: OpenRouter (has free models, https://openrouter.ai/keys)
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=<any model id ending in :free from https://openrouter.ai/models>
# AI_API_KEY=your-key

# Language of the AI explanation
AI_LANGUAGE=Turkish
AI_TIMEOUT=60

# --- Database ---------------------------------------------------------------
# CHESS_DB_PATH=data/chess.db
